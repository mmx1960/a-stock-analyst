# A 股分析系统 - 环境配置
# 复制为 .env 后按需修改

# Flask
SECRET_KEY=change-me-to-a-random-string
DEBUG=false
PORT=8888

# AI 配置（可选，用于 AI 辅助分析）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4

# DuckDB 本地缓存
DUCKDB_PATH=data/ashare.duckdb
ASHARE_DUCKDB_READ_ONLY=0
DUCKDB_READ_THROUGH=true
HISTORICAL_STORAGE=duckdb

# 数据源选择
PRIMARY_MARKET_SOURCE=mootdx
SECONDARY_MARKET_SOURCE=tencent
LOW_FREQ_SOURCE=akshare
HOTSPOT_SOURCE=kaipanla

# 通达信 mootdx（行情/K线主源）
TDX_HOST=127.0.0.1
TDX_PORT=7709
TDX_BESTIP_TIMEOUT=3.0

# 腾讯财经（估值/市值/换手率/量比补字段）
TENCENT_API=https://qt.gtimg.cn
TENCENT_TIMEOUT=8.0

# AKShare（只做低频 fallback：股票列表、公告、研报、F10 等）
AKSHARE_RATE_LIMIT=5

# 开盘啦/同花顺热点层（当前落地：开盘啦 App API）
KAIPANLA_RATE_LIMIT=0.5

# i问财（待实现 provider；需要自行抓 cookie）
IWENCAI_COOKIE=
IWENCAI_RATE_LIMIT=30
